# Copy to .env or set these in your host's dashboard
PORT=3000
NODE_ENV=production
# Free key from football-data.org (can also be set later in the Admin tab)
FOOTBALL_DATA_KEY=
# This email becomes the admin when it signs up. If empty, the FIRST person to sign up is admin.
ADMIN_EMAIL=
# Leave empty for a local JSON file (data/db.json). Set to a Postgres URL on a host like Render.
DATABASE_URL=
# Set to 1 when running behind a proxy (Render, Nginx) so rate limits see real IPs
TRUST_PROXY=1
# Timezone used to group matches into days
TZ=Africa/Harare
